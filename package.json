{
  "name": "aksjeliga",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "test:db": "pnpm --filter @aksjeliga/db test:db",
    "db:reset": "supabase db reset && pnpm db:seed",
    "db:seed": "pnpm --filter @aksjeliga/db seed",
    "db:generate": "pnpm --filter @aksjeliga/db db:generate",
    "test:e2e": "pnpm --filter @aksjeliga/web test:e2e"
  },
  "prettier": "@aksjeliga/config/prettier",
  "devDependencies": {
    "@aksjeliga/config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
