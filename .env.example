# Copy to .env in the repo root:  cp .env.example .env
# The values below are the fixed defaults of the LOCAL Supabase stack (`pnpm db:start`),
# not secrets. Run `pnpm db:status` to see them. Never commit real keys for a hosted project.

# Supabase API, used by the browser and server (Auth, RLS-scoped queries).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server only. Bypasses RLS; used by jobs and admin tasks. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Direct Postgres connection, used by Drizzle (migrations, trades in transactions).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Shared secret for cron endpoints (phase 5). Any long random string locally.
CRON_SECRET=local-dev-cron-secret-change-me

# Dev-only "time machine" on the profile page: move the app clock to test opening hours.
# Ignored in production builds.
ALLOW_TIME_TRAVEL=1
