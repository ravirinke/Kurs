  },
  "dependencies": {
    "@aksjeliga/core": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "^0.45.4",
    "luxon": "^3.7.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@aksjeliga/config": "workspace:*",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.12.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
